/dts-v1/;
/plugin/;

/{
	fragment@0 {
		target-path="/";
		__overlay__ {
			chosen {
				overlays {
					BB-SPI0 = "__TIMESTAMP__";
				};
			};
		};
	};

	fragment@1 {
		target = <&am33xx_pinmux>;
		__overlay__ {
			bb_spi0_pins: bb_spi0_pins_grp {
				pinctrl-single,pins = <
					0x150 0x30 0x0
					0x154 0x30 0x0
					0x158 0x10 0x0
					0x15C 0x10 0x0
				>;
			};
		};
	};

	fragment@2 {
		target = <&spi0>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <&bb_spi0_pins>;

			spidev0_0: spi@0 {
				compatible = "rohm,dh2228fv";
				reg = <0>;
				spi-max-frequency = <16000000>;
			};
		};
	};

	fragment@3 {
		target = <&ocp>;
		__overlay__ {
			P9_17_pinmux { status = "disabled"; };
			P9_18_pinmux { status = "disabled"; };
			P9_21_pinmux { status = "disabled"; };
			P9_22_pinmux { status = "disabled"; };
		};
	};
};